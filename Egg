-- [2] 최적화된 아이템 필터링 및 순간이동 루프 (렉 방지용 task.defer / task.wait 활용)
local function GetTargetEgg()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    local rootPart = character.HumanoidRootPart

    local closestEgg = nil
    local shortestDist = math.huge

    -- workspace 순회 (성능 부하를 줄이기 위해 하위 구조 정밀 탐색)
    for _, obj in ipairs(Config.TargetFolder:GetDescendants()) do
        if obj:IsA("BasePart") then
            local nameLower = obj.Name:lower()
            -- 계란/아이템 키워드 매칭
            if nameLower:find("egg") or nameLower:find("steal") or nameLower:find("item") then
                
                -- 맵 필터 검증 (오브젝트 상위 부모나 경로에 맵 이름이 포함되어 있는지 확인)
                if Config.SelectedMap ~= "All" then
                    local parentPath = obj:GetFullName()
                    if not parentPath:lower():find(Config.SelectedMap:lower()) then
                        continue
                    end
                end

                -- 등급/티어 필터 검증 (오브젝트 이름이나 속성 태그에 등급이 포함되어 있는지 확인)
                if Config.SelectedTier ~= "All" then
                    if not nameLower:find(Config.SelectedTier:lower()) then
                        continue
                    end
                end

                local dist = (rootPart.Position - obj.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closestEgg = obj
                end
            end
        end
    end

    return closestEgg
end

-- 백그라운드 파밍 스레드 (모바일 CPU 부하 최소화)
task.spawn(function()
    while true do
        task.wait(Config.TeleportDelay)
        
        if Config.Enabled then
            pcall(function()
                local character = LocalPlayer.Character
                if character and character:FindFirstChild("HumanoidRootPart") then
                    local rootPart = character.HumanoidRootPart
                    local target = GetTargetEgg()
                    
                    if target then
                        -- 계란 위치 위로 안전하게 순간이동
                        rootPart.CFrame = target.CFrame + Vector3.new(0, 3, 0)
                        
                        -- 상호작용 프롬프트 자동 트리거
                        for _, prompt in ipairs(target:GetDescendants()) do
                            if prompt:IsA("ProximityPrompt") then
                                fireproximityprompt(prompt)
                            end
                        end
                    end
                end
            end)
        end
    end
end)

